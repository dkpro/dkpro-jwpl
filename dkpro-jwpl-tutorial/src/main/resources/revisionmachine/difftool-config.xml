<!--
  Sample DiffTool configuration for the RevisionMachine tutorial (see README.md of this module).
  It reads one bzip2-compressed meta-history dump and writes uncompressed SQL files
  (output_1.sql, output_2.sql, ...) into the directory given in output/PATH.

  Note: paths (input path, output PATH, logging root_folder) must be enclosed in double quotes.
-->
<config>
	<values>
		<VALUE_MINIMUM_LONGEST_COMMON_SUBSTRING>12</VALUE_MINIMUM_LONGEST_COMMON_SUBSTRING>
		<COUNTER_FULL_REVISION>1000</COUNTER_FULL_REVISION>
	</values>
	<input>
		<MODE_SURROGATES>DISCARD_REVISION</MODE_SURROGATES>
		<WIKIPEDIA_ENCODING>UTF-8</WIKIPEDIA_ENCODING>
		<!-- one archive element per dump file; multiple archives are processed one after another -->
		<archive>
			<type>BZIP2</type>
			<path>"/data/dumps/simplewiki-20260101-pages-meta-history.xml.bz2"</path>
			<start>0</start>
		</archive>
	</input>
	<output>
		<!-- UNCOMPRESSED, BZIP2 or SEVENZIP (the latter requires externals/sevenzip) -->
		<OUTPUT_MODE>UNCOMPRESSED</OUTPUT_MODE>
		<PATH>"/data/revisionmachine/"</PATH>
		<LIMIT_SQL_FILE_SIZE>1000000000</LIMIT_SQL_FILE_SIZE>
		<MODE_ZIP_COMPRESSION_ENABLED>true</MODE_ZIP_COMPRESSION_ENABLED>
		<!-- true writes CSV data files instead of SQL files -->
		<MODE_DATAFILE_OUTPUT>false</MODE_DATAFILE_OUTPUT>
	</output>
	<cache>
		<LIMIT_TASK_SIZE_REVISIONS>5000000</LIMIT_TASK_SIZE_REVISIONS>
		<LIMIT_TASK_SIZE_DIFFS>1000000</LIMIT_TASK_SIZE_DIFFS>
		<LIMIT_SQLSERVER_MAX_ALLOWED_PACKET>1000000</LIMIT_SQLSERVER_MAX_ALLOWED_PACKET>
	</cache>
	<logging>
		<root_folder>"/data/revisionmachine/logs/"</root_folder>
		<diff_tool>
			<level>INFO</level>
		</diff_tool>
	</logging>
	<debug>
		<verification_diff>false</verification_diff>
		<verification_encoding>false</verification_encoding>
		<statistical_output>false</statistical_output>
		<debug_output>
			<enabled>false</enabled>
		</debug_output>
	</debug>
	<filter>
		<!-- white list of namespaces; if empty, all namespaces are kept -->
		<namespaces>
			<ns>0</ns>
			<ns>1</ns>
		</namespaces>
	</filter>
</config>
